        "y" : 0.5184257487169618,
        "w" : 0.6490255290855148
      }
    },
    {
      "confidence" : 1,
      "text" : "坐式和蹲式馬桶也會影響這條肌肉的功用。",
      "box" : {
        "x" : 0.14027608428439364,
        "h" : 0.02153171033549872,
