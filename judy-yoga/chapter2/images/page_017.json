        "y" : 0.2500000003593299,
        "h" : 0.018895348305426607
      }
    },
    {
      "text" : "她練習時習慣提會陰（即收縮海底輪）。",
      "confidence" : 1,
      "box" : {
        "x" : 0.15289256481883248,
