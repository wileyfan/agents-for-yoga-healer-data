    {
      "box" : {
        "w" : 0.6342975257154935,
        "x" : 0.16115701773552366,
        "h" : 0.017441859870770737,
        "y" : 0.2529069771036512
      },
      "text" : "一般年輕人最常犯的姿勢，站沒站像，就是指這種型。多半是肚",
      "confidence" : 1
    },
    {
      "box" : {
